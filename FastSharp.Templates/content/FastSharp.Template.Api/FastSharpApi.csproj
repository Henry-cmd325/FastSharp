<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastSharp.Modules" Version="__FASTSHARP_MODULES_VERSION__" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.8.0" />
<!--#if (EnableSwagger)-->
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.2" />
<!--#endif-->
<!--#if (Database == "InMemory")-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
<!--#endif-->
<!--#if (Database == "SqlServer")-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
<!--#endif-->
<!--#if (Database == "Postgres")-->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
<!--#endif-->
<!--#if (Database == "MySql")-->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
<!--#endif-->
  </ItemGroup>

</Project>
