<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>FastSharp.Templates</PackageId>
    <Title>FastSharp Project Templates</Title>
    <Version>1.0.0-beta.13</Version>
    <Authors>ikeredu</Authors>
    <Description>Templates for creating modular ASP.NET Core APIs using FastSharp.</Description>
    <RepositoryUrl>https://github.com/Henry-cmd325/FastSharp</RepositoryUrl>
    <PackageTags>dotnet-new;templates;fastsharp;minimal-api;modular</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <_TemplateContentDirectory>$(BaseIntermediateOutputPath)template-content</_TemplateContentDirectory>
    <_FastSharpModulesVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</_FastSharpModulesVersion>
    <_FastSharpModulesVersion Condition="'$(_FastSharpModulesVersion)' == ''">$(Version)</_FastSharpModulesVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>

  <Target Name="StageTemplateContent" BeforeTargets="_GetPackageFiles">
    <RemoveDir Directories="$(_TemplateContentDirectory)" />
    <Copy SourceFiles="@(Content)"
          DestinationFiles="@(Content->'$(_TemplateContentDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <XmlPoke XmlInputPath="$(_TemplateContentDirectory)\FastSharp.Template.Api\FastSharpApi.csproj"
             Query="/Project/ItemGroup/PackageReference[@Include='FastSharp.Modules']/@Version"
             Value="$(_FastSharpModulesVersion)" />
    <ItemGroup>
      <Content Remove="@(Content)" />
      <Content Include="$(_TemplateContentDirectory)\**\*">
        <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
        <PackagePath>content\content\%(Link)</PackagePath>
      </Content>
    </ItemGroup>
  </Target>

</Project>
