<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>FastSharp.Templates</PackageId>
    <Title>FastSharp Project Templates</Title>
    <Version>1.0.0-beta.11</Version>
    <Authors>ikeredu</Authors>
    <Description>Templates for creating modular ASP.NET Core APIs using FastSharp.</Description>
    <RepositoryUrl>https://github.com/Henry-cmd325/FastSharp</RepositoryUrl>
    <PackageTags>dotnet-new;templates;fastsharp;minimal-api;modular</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>

</Project>
